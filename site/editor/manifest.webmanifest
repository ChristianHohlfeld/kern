{
  "name": "Kern Studio",
  "short_name": "Kern",
  "description": "Kern Studio: the game engine editor in your browser. Build, play and share games, offline too.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#151516",
  "theme_color": "#151516",
  "categories": ["developer", "games", "productivity"],
  "lang": "en",
  "icons": [
    {"src": "./icons/kern-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "./icons/kern-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "./icons/kern-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/json": [".klevel"]}}
  ]
}
